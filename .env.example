# Copy to .env (never commit .env) and export these variables before running.
# Optional: enables Gemini for PDF Q&A. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Optional: use a different Hugging Face model id or a local folder
# SUMMARIZER_MODEL=MBZUAI/LaMini-Flan-T5-248M

# Optional: path to tesseract.exe if it is not on PATH (needed only for image OCR)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
